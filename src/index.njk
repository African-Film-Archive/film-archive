", "tp": "feature", "era": "festival-era", "url": "", "img": "https://a.ltrbxd.com/resized/film-poster/4/0/6/3/4063-andalucia-0-230-0-345-crop.jpg?v=1d992b9d68"}, {"t": "Shoot the Messenger", "d": "Ngozi Onwurah", "y": 2006, "c": ["United Kingdom"], "g": "drama satire", "tp": "feature", "era": "festival-era", "url": "", "img": "https://a.ltrbxd.com/resized/film-poster/2/0/3/2/3/1/203231-shoot-the-messenger-0-230-0-345-crop.jpg?v=35b1ea3475"}, {"t": "Sexe, gombo et beurre sale (Sex, Okra and Salted Butter)", "d": "Mahamat-Saleh Haroun", "y": 2008, "c": ["Chad", "France"], "g": "comedy drama", "tp": "feature", "era": "festival-era", "url": "", "img": ""}, {"t": "Moloch Tropical", "d": "Raoul Peck", "y": 2009, "c": ["Haiti", "France"], "g": "political drama", "tp": "feature", "era": "festival-era", "url": "", "img": "https://a.ltrbxd.com/resized/film-poster/1/0/5/5/4/9/105549-moloch-tropical-0-230-0-345-crop.jpg?v=cc24c6ae43"}];
const CONT = {"Senegal": "Africa", "Guinea-Bissau": "Africa", "Republic of the Congo": "Africa", "Mali": "Africa", "Zambia": "Africa", "Nigeria": "Africa", "Lesotho": "Africa", "Egypt": "Africa", "Ivory Coast": "Africa", "Cameroon": "Africa", "South Africa": "Africa", "Burkina Faso": "Africa", "Ghana": "Africa", "Angola": "Africa", "Mauritania": "Africa", "Benin": "Africa", "Chad": "Africa", "Tunisia": "Africa", "Niger": "Africa", "Democratic Republic of the Congo": "Africa", "Kenya": "Africa", "Algeria": "Africa", "Ethiopia": "Africa", "Sudan": "Africa", "United Kingdom": "Europe", "Italy": "Europe", "Austria": "Europe", "Norway": "Europe", "Netherlands": "Europe", "Ireland": "Europe", "France": "Europe", "Belgium": "Europe", "Germany": "Europe", "Portugal": "Europe", "Switzerland": "Europe", "United States": "North America", "Lebanon": "Asia / Middle East", "Saudi Arabia": "Asia / Middle East", "Qatar": "Asia / Middle East"};
const DEC_LABEL = {1920:'Colonial Record',1930:'Early Diaspora',1940:'Wartime',1950:'Liberation',1960:'First Wave',1970:'Manifesto',1980:'Flourishing',1990:'Video Wave',2000:'Festival Era',2010:'New Voices',2020:'Present'};
const ERA_ORDER = ['pre-history','liberation','manifesto','flourishing','video-wave','festival-era','new-voices','present'];
const ERA_NAME = {'pre-history':'Pre-History','liberation':'Liberation','manifesto':'Manifesto','flourishing':'Flourishing','video-wave':'Video Wave','festival-era':'Festival Era','new-voices':'New Voices','present':'Present'};
function decadeOf(y){return Math.floor(y/10)*10;}
function valuesFor(f,facet){
  if(facet==='decade') return [decadeOf(f.y)+'s'];
  if(facet==='era') return f.era?[f.era]:[];
  if(facet==='country') return f.c;
  if(facet==='continent') return [...new Set(f.c.map(x=>CONT[x]||'Other'))];
  if(facet==='genre') return f.g?[f.g]:[];
  if(facet==='tp') return f.tp?[f.tp]:[];
  if(facet==='director') return f.d?[f.d]:[];
  return [];
}
function shortTag(facet,v){
  if(facet==='decade') return "'"+String(v).slice(2);
  if(facet==='continent'){return {'Africa':'AF','Europe':'EU','North America':'NA','Asia / Middle East':'AS','Other':'~'}[v]||v.slice(0,2);}
  return String(v).slice(0,3).toUpperCase();
}
function longLabel(facet,v){
  if(facet==='decade') return DEC_LABEL[parseInt(v)]||'';
  if(facet==='era') return ERA_NAME[v]||v;
  return v;
}
let curFacet='decade', curValue=null;
function buildButtons(){
  const groups={};
  FILMS.forEach(f=>valuesFor(f,curFacet).forEach(v=>{(groups[v]=groups[v]||[]).push(f);}));
  let keys=Object.keys(groups);
  if(curFacet==='decade') keys.sort((a,b)=>parseInt(a)-parseInt(b));
  else if(curFacet==='era') keys.sort((a,b)=>ERA_ORDER.indexOf(a)-ERA_ORDER.indexOf(b));
  else keys.sort((a,b)=>groups[b].length-groups[a].length || String(a).localeCompare(b));
  if(!keys.includes(curValue)) curValue=keys[0];
  const scroll=document.getElementById('eraScroll'); scroll.innerHTML='';
  keys.forEach(v=>{
    const b=document.createElement('button');
    b.className='era-btn'+(v===curValue?' active':'');
    b.innerHTML=`<span class="era-decade">${shortTag(curFacet,v)}</span><span class="era-label">${longLabel(curFacet,v)}</span><span class="era-count">${groups[v].length} titles</span>`;
    b.addEventListener('click',()=>{curValue=v; document.querySelectorAll('.era-btn').forEach(x=>x.classList.remove('active')); b.classList.add('active'); renderValue(v,groups[v]);});
    scroll.appendChild(b);
  });
  renderValue(curValue,groups[curValue]);
}
function renderValue(v,list){
  const facetName={decade:'Decade',era:'Era',country:'Country',continent:'Continent',genre:'Genre',tp:'Type',director:'Director'}[curFacet];
  document.getElementById('eraTitle').textContent = (longLabel(curFacet,v)&&curFacet==='decade')? `The ${DEC_LABEL[parseInt(v)]||v}` : `${facetName} : ${longLabel(curFacet,v)}`;
  document.getElementById('eraSub').textContent = `${list.length} titles in the archive`;
  const grid=document.getElementById('filmGrid'); grid.innerHTML='';
  list.slice().sort((a,b)=>a.y-b.y).forEach((film,i)=>{
    const card=document.createElement('div');
    card.className='film-card fade-in'; card.style.animationDelay=`${i*0.05}s`;
    const cc=(film.c&&film.c.length)?film.c.join(' / '):'';
    var posterImg = film.img ? ('<img src="'+film.img+'" alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1;">') : '';
    var meta=[film.tp,film.g,cc].filter(Boolean).join(' &middot; ');
    var moreLink = film.url ? ('<a class="film-more-link" href="'+film.url+'" target="_blank" rel="noopener">More info &#8594;</a>') : '';
    card.innerHTML=`
      <div class="film-reel">${posterImg}<div class="sprockets left"><span></span><span></span><span></span><span></span><span></span><span></span></div><div class="sprockets right"><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="film-reel-inner"><div class="reel-top"><span>${film.tp||''}</span><span>${film.c[0]||''}</span></div><div class="reel-center">${film.t}</div><div class="reel-bottom"><span>${film.y}</span><span>${film.g||''}</span></div></div></div>
      <div class="film-info"><div class="film-title-line">${film.t}</div><div class="film-director">DIR. ${(film.d||'').toUpperCase()}</div><div class="film-year">${film.y} &middot; ${cc}</div>
        <div class="film-more"><div class="film-more-meta">${meta}</div>${moreLink}</div>
        <div class="film-cue">Details &#9662;</div></div>`;
    card.addEventListener('click',function(e){
      if(e.target.closest('.film-more-link')) return;
      var wasOpen=card.classList.contains('open');
      document.querySelectorAll('.film-card.open').forEach(function(c){c.classList.remove('open');});
      if(!wasOpen) card.classList.add('open');
    });
    grid.appendChild(card);
  });
}
document.getElementById('facetSelect').addEventListener('change',e=>{curFacet=e.target.value;curValue=null;buildButtons();});
// live Lagos date + issue number
(function(){
  const now=new Date();
  document.getElementById('liveDate').textContent = now.toLocaleDateString('en-GB',{timeZone:'Africa/Lagos',weekday:'short',day:'2-digit',month:'short',year:'numeric'}).toUpperCase().replace(',','');
  const iss=Math.max(1,(now.getFullYear()-2026)*12+(now.getMonth()-7)+1);
  document.getElementById('issueNo').innerHTML='ISSUE N&deg; '+String(iss).padStart(2,'0');
})();
(function(){
  var b=document.getElementById('menuBtn'), l=document.getElementById('menuList');
  if(b){ b.addEventListener('click',function(e){e.stopPropagation(); l.style.display = l.style.display==='block'?'none':'block';});
    document.addEventListener('click',function(){ l.style.display='none'; }); }
})();
buildButtons();
document.querySelectorAll('.review-item').forEach(function(r){
  r.addEventListener('click',function(){
    var wasOpen=r.classList.contains('open');
    document.querySelectorAll('.review-item.open').forEach(function(x){ x.classList.remove('open'); var mm=x.querySelector('.review-more'); if(mm) mm.innerHTML='Read the full review &#9662;'; });
    if(!wasOpen){ r.classList.add('open'); var m=r.querySelector('.review-more'); if(m) m.innerHTML='Close &#9652;'; }
  });
});
</script>

</body>
</html>

