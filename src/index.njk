---
permalink: "/"
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reels &amp; Records, African Film Archive</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IM+Fell+DW+Pica:ital@0;1&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Special+Elite&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #e8dcc0;
    --paper-dark: #d4c3a0;
    --ink: #2b1d0e;
    --ink-soft: #4a3720;
    --sepia: #8a5a2a;
    --amber: #c8821f;
    --rust: #a43920;
    --vhs-cyan: #3a9a9a;
    --vhs-magenta: #b84872;
    --shadow: rgba(43, 29, 14, 0.25);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 18px;
    line-height: 1.5;
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
  }

  /* ========== FILM GRAIN OVERLAY ========== */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.12;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix values='0 0 0 0 0.17 0 0 0 0 0.11 0 0 0 0 0.05 0 0 0 1 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    animation: grain 0.6s steps(3) infinite;
  }

  @keyframes grain {
    0%, 100% { transform: translate(0,0); }
    25% { transform: translate(-2%, 1%); }
    50% { transform: translate(1%, -2%); }
    75% { transform: translate(-1%, 2%); }
  }

  /* ========== VHS SCAN LINES ========== */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9998;
    background: repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 2px,
      rgba(43, 29, 14, 0.03) 2px,
      rgba(43, 29, 14, 0.03) 3px
    );
  }

  /* ========== PAPER TEXTURE ========== */
  .paper-bg {
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(138, 90, 42, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(164, 57, 32, 0.06) 0%, transparent 50%),
      radial-gradient(circle at 40% 90%, rgba(200, 130, 31, 0.05) 0%, transparent 40%);
  }

  /* ========== TOP BAR ========== */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 2px double var(--ink);
    padding: 0.6rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Special Elite', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .topbar-left, .topbar-right {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .rec-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--rust);
    border-radius: 50%;
    animation: blink 1.2s ease-in-out infinite;
    margin-right: 0.4rem;
  }

  @keyframes blink {
    0%, 60% { opacity: 1; }
    80%, 100% { opacity: 0.2; }
  }

  .tracking {
    color: var(--sepia);
  }

  /* ========== MASTHEAD ========== */
  .masthead {
    padding: 4rem 2rem 2rem;
    border-bottom: 1px solid var(--ink);
    position: relative;
  }

  .masthead-meta {
    display: flex;
    justify-content: space-between;
    font-family: 'Special Elite', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sepia);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.8rem;
    margin-bottom: 2rem;
  }

  .title {
    font-family: 'IM Fell DW Pica', serif;
    font-size: clamp(4rem, 14vw, 12rem);
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: -0.02em;
    text-align: center;
    margin: 0;
    position: relative;
    color: var(--ink);
    text-shadow: 
      2px 0 0 rgba(184, 72, 114, 0.15),
      -2px 0 0 rgba(58, 154, 154, 0.15);
  }

  .title .ampersand {
    font-style: italic;
    color: var(--rust);
    font-size: 0.7em;
    vertical-align: 0.1em;
  }

  .tagline {
    text-align: center;
    font-family: 'IM Fell DW Pica', serif;
    font-style: italic;
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--ink-soft);
    margin-top: 1.5rem;
    letter-spacing: 0.05em;
  }

  .tagline-rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 2rem auto 0;
    max-width: 500px;
  }

  .tagline-rule::before,
  .tagline-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--ink);
  }

  .tagline-rule span {
    font-family: 'Special Elite', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--sepia);
  }

  /* ========== ERA TIMELINE ========== */
  .era-section {
    padding: 3rem 2rem;
    border-bottom: 1px solid var(--ink);
  }

  .section-label {
    font-family: 'Special Elite', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--sepia);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .section-label::before {
    content: '◉';
    color: var(--rust);
  }

  .era-scroll {
    display: flex;
    gap: 0;
    overflow-x: auto;
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--sepia) transparent;
    position: relative;
  }

  .era-scroll::-webkit-scrollbar { height: 6px; }
  .era-scroll::-webkit-scrollbar-track { background: transparent; border-top: 1px dashed var(--sepia); }
  .era-scroll::-webkit-scrollbar-thumb { background: var(--sepia); }

  .era-btn {
    flex-shrink: 0;
    min-width: 140px;
    padding: 1.2rem 1rem;
    background: transparent;
    border: none;
    border-right: 1px dashed var(--ink-soft);
    font-family: 'IM Fell DW Pica', serif;
    color: var(--ink);
    cursor: pointer;
    text-align: center;
    transition: all 0.3s ease;
    position: relative;
  }

  .era-btn:last-child { border-right: none; }

  .era-btn:hover { background: var(--paper-dark); }

  .era-btn.active {
    background: var(--ink);
    color: var(--paper);
  }

  .era-btn.active::after {
    content: '▼';
    position: absolute;
    bottom: -14px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ink);
    font-size: 1rem;
  }

  .era-decade {
    font-size: 2rem;
    font-weight: 400;
    line-height: 1;
    display: block;
  }

  .era-label {
    font-family: 'Special Elite', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: 0.4rem;
    display: block;
    opacity: 0.7;
  }

  .era-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    margin-top: 0.3rem;
    display: block;
    opacity: 0.5;
  }

  /* ========== SPOTLIGHT ========== */
  .spotlight {
    padding: 4rem 2rem;
    border-bottom: 1px solid var(--ink);
    position: relative;
  }

  .spotlight-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .spotlight-title {
    font-family: 'IM Fell DW Pica', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-style: italic;
    color: var(--ink);
    line-height: 1;
  }

  .spotlight-meta {
    font-family: 'Special Elite', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sepia);
  }

  .film-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2.5rem 1.5rem;
  }

  .film-card {
    position: relative;
    cursor: pointer;
    transition: transform 0.4s ease;
  }

  .film-card:hover {
    transform: translateY(-4px) rotate(-0.5deg);
  }

  .film-reel {
    aspect-ratio: 2 / 3;
    background: var(--ink);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ink);
    box-shadow: 
      3px 3px 0 var(--sepia),
      6px 6px 20px var(--shadow);
  }

  .film-reel::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(135deg, transparent 40%, rgba(200, 130, 31, 0.15) 50%, transparent 60%),
      repeating-linear-gradient(0deg, transparent, transparent 18px, rgba(232, 220, 192, 0.04) 18px, rgba(232, 220, 192, 0.04) 20px);
    z-index: 2;
    pointer-events: none;
  }

  .film-reel-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    color: var(--paper);
  }

  .reel-top {
    font-family: 'Special Elite', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.6;
    display: flex;
    justify-content: space-between;
  }

  .reel-center {
    text-align: center;
    font-family: 'IM Fell DW Pica', serif;
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .reel-bottom {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    opacity: 0.7;
    display: flex;
    justify-content: space-between;
  }

  /* Sprocket holes */
  .sprockets {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    padding: 8px 0;
    z-index: 3;
  }

  .sprockets.left { left: 0; }
  .sprockets.right { right: 0; }

  .sprockets span {
    width: 8px;
    height: 10px;
    background: var(--paper);
    margin: 0 auto;
    border-radius: 1px;
  }

  .film-info {
    padding-top: 0.8rem;
  }

  .film-title-line {
    font-family: 'IM Fell DW Pica', serif;
    font-size: 1.1rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .film-director {
    font-family: 'Special Elite', monospace;
    font-size: 0.7rem;
    color: var(--sepia);
    letter-spacing: 0.1em;
    margin-top: 0.2rem;
  }

  .film-year {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--ink-soft);
    margin-top: 0.2rem;
  }

  /* ========== CONTENT COLUMNS ========== */
  .three-col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-bottom: 1px solid var(--ink);
  }

  .col {
    padding: 3rem 2rem;
    border-right: 1px solid var(--ink);
    position: relative;
  }

  .col:last-child { border-right: none; }

  .col-header {
    font-family: 'IM Fell DW Pica', serif;
    font-size: 2rem;
    font-style: italic;
    margin-bottom: 0.3rem;
    color: var(--ink);
  }

  .col-kicker {
    font-family: 'Special Elite', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 1.5rem;
    display: block;
  }

  /* ========== INTERVIEW / PODCAST CARDS ========== */
  .podcast-item {
    display: flex;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px dashed var(--ink-soft);
    cursor: pointer;
    transition: padding-left 0.3s;
  }

  .podcast-item:hover { padding-left: 0.6rem; }
  .podcast-item:last-child { border-bottom: none; }

  .cassette {
    flex-shrink: 0;
    width: 70px;
    height: 44px;
    background: var(--ink);
    position: relative;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0 8px;
  }

  .reel-wheel {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--sepia);
    position: relative;
    animation: spin 4s linear infinite;
    animation-play-state: paused;
  }

  .podcast-item:hover .reel-wheel { animation-play-state: running; }

  .reel-wheel::before {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--sepia);
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .cassette-label {
    position: absolute;
    bottom: -3px;
    left: 8px;
    right: 8px;
    height: 4px;
    background: var(--paper);
  }

  .podcast-info { flex: 1; }

  .podcast-title {
    font-family: 'IM Fell DW Pica', serif;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }

  .podcast-guest {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--sepia);
    font-size: 0.95rem;
  }

  .podcast-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--ink-soft);
    margin-top: 0.3rem;
    letter-spacing: 0.05em;
  }

  /* ========== REVIEWS ========== */
  .review-item {
    padding: 1.5rem 0;
    border-bottom: 1px dashed var(--ink-soft);
    cursor: pointer;
  }

  .review-item:last-child { border-bottom: none; }

  .review-stars {
    font-family: 'JetBrains Mono', monospace;
    color: var(--rust);
    letter-spacing: 0.15em;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .review-title {
    font-family: 'IM Fell DW Pica', serif;
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 0.3rem;
  }

  .review-title em {
    color: var(--rust);
  }

  .review-excerpt {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-soft);
    font-style: italic;
  }

  .review-byline {
    font-family: 'Special Elite', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sepia);
    margin-top: 0.5rem;
  }

  /* ========== CLIPS ========== */
  .clip-item {
    padding: 1.2rem 0;
    border-bottom: 1px dashed var(--ink-soft);
    cursor: pointer;
    position: relative;
  }

  .clip-item:last-child { border-bottom: none; }

  .clip-thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--ink);
    position: relative;
    overflow: hidden;
    margin-bottom: 0.8rem;
    border: 1px solid var(--ink);
  }

  .clip-thumb::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      repeating-linear-gradient(0deg, transparent, transparent 4px, rgba(232, 220, 192, 0.08) 4px, rgba(232, 220, 192, 0.08) 5px);
  }

  .clip-thumb::after {
    content: '▶';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--paper);
    font-size: 2rem;
    opacity: 0.8;
    transition: transform 0.3s;
  }

  .clip-item:hover .clip-thumb::after {
    transform: translate(-50%, -50%) scale(1.3);
  }

  .clip-duration {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: var(--paper);
    color: var(--ink);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    padding: 2px 6px;
    z-index: 2;
    letter-spacing: 0.1em;
  }

  .clip-caption {
    font-family: 'Special Elite', monospace;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 0.7rem;
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.05em;
    position: relative;
  }

  .clip-caption::before {
    content: '[CC]';
    color: var(--amber);
    margin-right: 0.5rem;
    font-weight: bold;
  }

  .clip-source {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--sepia);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  /* ========== DISPATCHES (footer feed) ========== */
  .dispatches {
    padding: 3rem 2rem;
    background: var(--ink);
    color: var(--paper);
  }

  .dispatches .section-label {
    color: var(--amber);
  }

  .dispatches .section-label::before {
    color: var(--amber);
  }

  .dispatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .dispatch {
    border-left: 2px solid var(--amber);
    padding-left: 1rem;
  }

  .dispatch-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--amber);
    letter-spacing: 0.1em;
    margin-bottom: 0.4rem;
  }

  .dispatch-title {
    font-family: 'IM Fell DW Pica', serif;
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  /* ========== COLOPHON ========== */
  .colophon {
    padding: 3rem 2rem 4rem;
    text-align: center;
    background: var(--paper);
    border-top: 2px double var(--ink);
  }

  .colophon-mark {
    font-family: 'IM Fell DW Pica', serif;
    font-style: italic;
    font-size: 2rem;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .colophon-text {
    font-family: 'Special Elite', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sepia);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.8;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 900px) {
    .three-col { grid-template-columns: 1fr; }
    .col { border-right: none; border-bottom: 1px solid var(--ink); }
    .col:last-child { border-bottom: none; }
    .topbar { padding: 0.6rem 1rem; font-size: 0.65rem; }
    .topbar-left, .topbar-right { gap: 0.8rem; }
    .masthead, .era-section, .spotlight, .col, .dispatches { padding-left: 1rem; padding-right: 1rem; }
  }

  @media (max-width: 600px) {
    .topbar-right { display: none; } .topbar-center a { font-size:0.7rem; }
  }

  /* ========== ENTRY ANIMATIONS ========== */
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s ease forwards;
  }

  .fade-in:nth-child(1) { animation-delay: 0.1s; }
  .fade-in:nth-child(2) { animation-delay: 0.2s; }
  .fade-in:nth-child(3) { animation-delay: 0.3s; }
  .fade-in:nth-child(4) { animation-delay: 0.4s; }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

/* --- responsive additions --- */
@media (max-width: 720px){
  .three-col{grid-template-columns:1fr !important;}
  .film-grid{grid-template-columns:1fr 1fr !important;}
  .title{font-size:2.3rem !important;}
  .masthead-meta{flex-direction:row;flex-wrap:wrap;gap:.5rem;}
  .era-scroll{-webkit-overflow-scrolling:touch;}
}
@media (max-width: 440px){
  .film-grid{grid-template-columns:1fr !important;}
  .title{font-size:1.8rem !important;}
}
</style>
</head>
<body class="paper-bg">

  <!-- ======================= TOP BAR ======================= -->
  <div class="topbar">
    <div class="topbar-left">
      <span><span class="rec-dot"></span>REC</span>
      <span class="tracking">TRK ▓▓▓▓▓░</span>
      <span>CH 03</span>
    </div>
    <nav class="topbar-center" style="position:relative;">
      <button id="menuBtn" style="font-family:'Special Elite',monospace;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;background:transparent;border:1px solid var(--ink);color:var(--ink);padding:0.25rem 0.8rem;cursor:pointer;">Menu &#9662;</button>
      <div id="menuList" style="display:none;position:absolute;top:130%;left:50%;transform:translateX(-50%);background:var(--paper);border:1px solid var(--ink);min-width:150px;z-index:300;box-shadow:3px 3px 0 var(--ink-soft);text-align:left;">
        <a href="/" style="display:block;padding:0.55rem 1rem;color:inherit;text-decoration:none;border-bottom:1px solid var(--ink-soft);">Home</a>
        <a href="/membership/" style="display:block;padding:0.55rem 1rem;color:inherit;text-decoration:none;">Support</a>
      </div>
