---
layout: base.njk
---
{% set currentEra = eras | findEra(eraSlug) %}
<section class="hero">
  <h1>{{ currentEra.name }}</h1>
  <p>{{ currentEra.range }} — {{ currentEra.description }}</p>
</section>

<div class="film-grid">
  {% for film in films | byEra(eraSlug) %}
  <div class="film-card">
    <a href="/films/{{ film.id }}/">
      {% if film.poster_image %}<img src="{{ film.poster_image }}" alt="{{ film.title }} poster" loading="lazy" style="width:100%;aspect-ratio:2/3;object-fit:cover;">{% endif %}
      <h3>{{ film.title }}</h3>
      <p class="meta">{{ film.year }} — {{ film.director }}</p>
      <p class="meta">{{ film.country | join(", ") }}</p>
    </a>
  </div>
  {% endfor %}
</div>
